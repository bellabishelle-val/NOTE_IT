# M-PESA API Configuration
# Copy this file to .env and update with your actual Safaricom credentials

# M-PESA Consumer Key
MPESA_CONSUMER_KEY=your_safaricom_consumer_key_here

# M-PESA Consumer Secret
MPESA_CONSUMER_SECRET=your_safaricom_consumer_secret_here

# M-PESA Shortcode (Paybill/Till number)
MPESA_SHORTCODE=174379

# M-PESA Passkey
MPESA_PASSKEY=your_safaricom_passkey_here

# Environment (sandbox or production)
NODE_ENV=sandbox

# M-PESA Callback URL (where Safaricom sends payment results)
MPESA_CALLBACK_URL=https://yourdomain.com/api/mpesa/callback

# JWT Secret for authentication
JWT_SECRET=your_jwt_secret_key_here

# Database Configuration
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=
DB_NAME=note_it
